config DRM_SAMSUNG_FELIX
	tristate "Samsung DPU for Pixel Fold felix (gs201) outer panel"
	depends on DRM && ARCH_EXYNOS
	select DRM_KMS_HELPER
	select DRM_MIPI_DSI
	select DRM_DISPLAY_HELPER
	select DRM_DISPLAY_DSC_HELPER
	select DRM_GEM_DMA_HELPER
	select DRM_PANEL_BRIDGE
	select VIDEOMODE_HELPERS
	help
	  Grafted AOSP samsung DRM stack (DECON1/DSIM1/DPP) to drive the felix
	  outer/cover panel samsung,ea8182-f10 (command-mode, DSC). Bring-up WIP.
