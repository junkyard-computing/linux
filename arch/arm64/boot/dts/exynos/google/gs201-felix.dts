// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel Fold (felix) device tree source
 *
 * Copyright 2026 Google LLC
 *
 * The Pixel Fold uses the GS201 (Tensor G2) SoC.
 *
 * Headless mainline Linux configuration:
 *   - Serial console via UART0 at 115200 baud (earlycon)
 *   - UFS storage via google,gs201-ufs
 *   - USB peripheral (CDC-NCM + CDC-ACM composite gadget) over USB-C
 *     (full DRD with role-switch waits on a MAX77759 TCPC port — Phase B)
 *   - GPU via Panthor (Mali-G710 CSF)
 *
 * Not enabled (no mainline driver or Android-only):
 *   - Display (DRM Samsung DECON + DSI panels)
 *   - Wi-Fi / Bluetooth (Broadcom BCM4390)
 *   - Cellular modem (Samsung S5300)
 *   - Camera (LWIS / ISP)
 *   - Audio (CS35L45, CS40L26)
 *   - NFC, fingerprint, touch
 *   - Google Security Anchor / GSC TPM (GSA/GSC)
 *   - AoC always-on coprocessor
 *   - EdgeTPU / GXP
 */

/dts-v1/;

#include "gs201.dtsi"
#include "gs201-android-handoff.dtsi"
#include "gs201-felix-trusty.dtsi"
#include <dt-bindings/usb/pd.h>

/ {
	model = "Google Pixel Fold";
	compatible = "google,felix", "google,gs201";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/*
	 * Fixed-regulator stub for the Mali GPU supply. Panthor's probe looks
	 * up a "mali" regulator via devm_regulator_get() to satisfy OPP voltage
	 * scaling and the Energy Model; on felix the GPU is actually fed by an
	 * ACPM-managed rail (BUCK_S2MPG13_3 / VDD_G3D), but there's no driver
	 * for that in this tree yet. A fixed-voltage regulator-always-on stub
	 * satisfies the regulator handle lookup and silences the
	 * "no regulator (mali) found" / "EM: invalid perf. state" errors during
	 * panthor probe. The GPU rail is already powered by the bootloader so
	 * nothing actually changes voltage at runtime.
	 */
	mali_vreg: regulator-mali {
		compatible = "regulator-fixed";
		regulator-name = "mali";
		regulator-min-microvolt = <900000>;
		regulator-max-microvolt = <900000>;
		regulator-always-on;
	};

	/*
	 * Placeholder regulator for the USB PHY + DWC3 supply phandles.
	 *
	 * Real felix routing has these supplies coming off S2MPG12 / S2MPG13
	 * (BUCK_S2MPG13_*, LDO_S2MPG12_*); neither chip has a mainline driver
	 * yet, so we feed both the gs101-usb31drd-phy regulator-bulk handles
	 * and the dwc3-exynos vdd33/vdd10 lookups from this single fixed-1V8
	 * always-on stub. Same shape as the placeholder used by
	 * gs101-pixel-common.dtsi (oriole / raven). Voltage value is nominal
	 * — the rails are already powered by the bootloader and nothing in
	 * the consumer paths attempts to reprogram them.
	 */
	reg_placeholder: regulator-usb-placeholder {
		compatible = "regulator-fixed";
		regulator-name = "usb-placeholder";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	/*
	 * Placeholder for the ea8182-f10 outer-panel rails (vci/vddi/vddd).
	 * Real routing is off S2MPG12/13 LDOs (m_ldo27/m_ldo23/disp_vddd), none
	 * modelled on mainline; the bootloader leaves the panel rails powered,
	 * so a single always-on stub satisfies the drm_panel supply lookups.
	 */
	reg_disp_placeholder: regulator-disp-placeholder {
		compatible = "regulator-fixed";
		regulator-name = "disp-placeholder";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

/* Wire the stub regulator to the GPU node as its mali-supply. */
&gpu {
	mali-supply = <&mali_vreg>;
};

/*
 * OUTER/cover panel ea8182-f10 on DSIM1. drmdsim1 itself stays disabled
 * (see gs201.dtsi) until the pd_dpu power-on + DSIM D-PHY shim land, so this
 * panel child does not probe yet.
 */
&drmdsim1 {
	/*
	 * NO `reg` property, and node name has no unit-address: the AOSP samsung
	 * dsim attaches the panel by matching `label` against the sec_panel_name
	 * module param (exynos_drm.sec_panel_name=dsim1:ea8182-f10). A `reg`
	 * property makes dsim_add_mipi_dsi_device() abort (it expects
	 * mipi_dsi_host_register to auto-add reg'd nodes, which doesn't create the
	 * device this driver needs) — matches AOSP gs201-felix-display.dtsi, whose
	 * panel nodes carry label+channel and no reg.
	 */
	panel {
		compatible = "samsung,ea8182-f10";
		label = "ea8182-f10";
		channel = <0>;
		/*
		 * Panel reset is gpp23-0 (matches AOSP gs201-felix-display.dtsi).
		 * The gpp23 bank is provided by gs101-pinctrl.dtsi (peric1), which
		 * gs201-felix.dts already includes, so this resolves to the real
		 * pin — the driver's devm_gpiod_get(dev, "reset") toggles it during
		 * the panel enable sequence.
		 */
		reset-gpios = <&gpp23 0 GPIO_ACTIVE_HIGH>;
		vci-supply = <&reg_disp_placeholder>;
		vddi-supply = <&reg_disp_placeholder>;
		vddd-supply = <&reg_disp_placeholder>;
	};
};

/*
 * Debug UART (UART0 / PERIC0 USI0). Enabled (4th attempt).
 *
 * Prior attempts (recorded so the failure modes are easy to spot
 * if any of them recur):
 *   1. samsung_tty as kernel console + fixed-clock stub →
 *      APC-early-watchdog bootloop, kernel hung silently.
 *   2. samsung_tty as platform driver only + 200 MHz fixed-clock
 *      stub → UART garbled at [1.25] when samsung_tty reprogrammed
 *      UBRDIV against a wrong rate.
 *   3. samsung_tty + real cmu_top/cmu_peric0 reusing gs101 driver
 *      data → kernel panic in clk_divider_recalc_rate (mainline
 *      reuses gs101 register offsets which don't all exist on gs201).
 *
 * What's different this time: clk-gs101.c now contains a minimal
 * gs201-specific peric0_cmu_info struct (peric0_cmu_info_gs201)
 * with the gs201 USI0_UART register offsets (DIV at 0x1808 instead
 * of 0x1804, GATE at 0x20c0 instead of 0x20bc). cmu_top stays
 * disabled — cmu_peric0's bus/ip parents come from fixed-clock
 * stubs at the rates AOSP cal-if reports for felix.
 *
 * Safety net: kernel cmdline still keeps `keep_bootcon` and does
 * NOT specify `console=ttySAC0,115200`, so kernel printk continues
 * via earlycon even if samsung_tty's setup against the new
 * cmu_peric0 path goes wrong. /dev/ttySAC0 surfaces only as a
 * platform-driver-bound port (not a kernel console), and
 * serial-getty@ttySAC0 (overlay symlink) opens it for an
 * interactive RX-IRQ-driven shell.
 */
&serial_0 {
	status = "okay";
};

/*
 * Enable UFS storage.
 * The controller and PHY are defined in gs201.dtsi; the GPIO pins used for
 * UFS reset and reference-clock output are PERIC0 / HSI2UFS domain pins.
 */
&ufs_0 {
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

/*
 * USB 3.1 (HSI0) — Phase A: peripheral-only gadget over the USB-C port.
 *
 * Felix has a single USB-C connector. Full DRD requires a MAX77759 TCPC
 * driver which mainline doesn't have (memory/reference_mainline_gs201_status.md);
 * Phase B will port that. For now, we hard-pin dr_mode = "peripheral" so
 * Linux comes up as a USB device — host machine sees a composite gadget
 * (CDC-NCM + CDC-ACM) for SSH-over-USB and serial console, freeing the
 * UART cable conflict (memory/project_felix_dongle_pd_workaround.md).
 *
 * No usb-role-switch, no Type-C connector node, no orientation switch —
 * those land in Phase B alongside the TCPC.
 *
 * All 6 PHY supplies + the 2 dwc3-exynos supplies are wired to
 * &reg_placeholder above; see that node for the rationale.
 */
/*
 * Phase G.9 USB SETUP-delivery investigation: enable the gs201 S2MPU stub
 * driver against the s2mpu_hsi0 device so we can test whether the
 * SETUP-no-show symptom is gated on a kernel-side claim of the device.
 * Stub does not write any S2MPU registers (the bootloader-programmed
 * permissions persist).
 */
&s2mpu_hsi0 {
	status = "okay";
};

&usbdrd31_phy {
	/*
	 * Phase A USB graft (felix only): switch the PHY init path from
	 * mainline's exynos5_usbdrd_gs201_utmi_init (a hand-translated
	 * subset of the AOSP CAL sequence) to the full AOSP CAL — built
	 * from kernel/source.aosp-backup/private/google-modules/soc/gs/
	 * drivers/phy/samsung/phy-exynos-usb3p1.c, grafted into the
	 * mainline phy-exynos5-usbdrd module by phy-exynos-usb3p1.[ch]
	 * + phy-samsung-usb-cal.h + phy-exynos-usb3p1-reg.h. The empirical
	 * record for why the graft is the cheapest remaining path is in
	 * kernel/asop_port_questions/gs-usb.md (post-walk, 2026-05-07).
	 *
	 * Reverting to "google,gs201-usb31drd-phy" rolls back to the
	 * mainline init path with no other changes — they're A/B sides of
	 * the same harness.
	 */
	compatible = "google,gs201-aosp-usb31drd-phy";
	pll-supply = <&reg_placeholder>;
	dvdd-usb20-supply = <&reg_placeholder>;
	vddh-usb20-supply = <&reg_placeholder>;
	vdd33-usb20-supply = <&reg_placeholder>;
	vdda-usbdp-supply = <&reg_placeholder>;
	vddh-usbdp-supply = <&reg_placeholder>;
	/*
	 * Phase G.9: mirror AOSP's `s2mpus = <&s2mpu_hsi0>;` (gs201.dtsi:791
	 * in source.aosp-backup). The phandle is informational on mainline
	 * — we have no driver hook that consumes it — but it makes the DT
	 * topology match AOSP and lets us verify by `dtc`-decompile that
	 * the relationship is declared, in case any future S2MPU driver
	 * key off it.
	 */
	s2mpus = <&s2mpu_hsi0>;
	status = "okay";
};

&usbdrd31 {
	vdd33-supply = <&reg_placeholder>;
	vdd10-supply = <&reg_placeholder>;
	/*
	 * Phase G.9 USB SETUP-delivery investigation: constrain the inner
	 * dwc3's DMA window to the lower 1 GiB of DRAM (0x80000000 -
	 * 0xc0000000). gs201 has 12 GiB total memory split into a low bank
	 * at 0x80000000 (1 GiB declared by our DT, expanded by the bootloader
	 * at runtime to ~4 GiB) and a high bank at 0x880000000 (8 GiB).
	 * Mainline dwc3 has no DMA-mask constraint, so dma_alloc_coherent
	 * for the gadget's EP0 OUT SETUP TRB lands wherever the buddy
	 * allocator decides — observed once at 0x8_9556a000 in the upper
	 * bank.
	 *
	 * The bootloader-programmed S2MPU permission table for the HSI0
	 * master almost certainly only whitelists the lower bank (the
	 * region the bootloader itself uses for fastboot USB transfers).
	 * AXI writes from the dwc3 master to upper-bank addresses get
	 * silently dropped, leaving the EP0 TRB with HWO=1 forever and
	 * the host stuck in the -EPROTO descriptor-read retry loop we've
	 * been chasing since Phase A.
	 *
	 * `dma-ranges` here pins all child DMA into 0x80000000-0xc0000000.
	 * of_dma_configure walks up the device tree on platform_device
	 * registration and uses this entry to limit the inner dwc3's
	 * dma_range_map / bus_dma_limit, so dma_alloc_coherent gets the
	 * constraint without any driver code change.
	 *
	 * If this works, S2MPU is confirmed and we keep this as the
	 * Phase A workaround. Phase B (real DRD with TCPC) may want a
	 * proper google,s2mpu driver port to permit upper-bank access
	 * for higher-throughput paths.
	 *
	 * Cell layout: child-addr (1 cell, usbdrd31's #address-cells=1)
	 *              parent-addr (2 cells, root #address-cells=2)
	 *              length (1 cell, usbdrd31's #size-cells=1)
	 *
	 * Identity mapping: child-addr == parent-addr (no offset
	 * translation). gs201's HSI0 master has no hardware bus
	 * address translator, so the dma-ranges entry must declare
	 * 1:1 mapping; the offset isn't a "shift the bus address"
	 * directive, only a "constrain allocations to this physical
	 * range" hint via bus_dma_limit.
	 *
	 * First attempt (2026-05-08) used <0x0 0x0 0x80000000 0x40000000>
	 * which IS a translating mapping (child sees 0x0 = parent 0x80000000),
	 * and observed allocations at child-side 0x0281f000 — the dwc3
	 * master then DMA-wrote to literal 0x0281f000 in physical
	 * memory, which is below DRAM and presumably not mapped.
	 * Identity-form below avoids the offset.
	 */
	dma-ranges = <0x80000000  0x0 0x80000000  0x40000000>;
	status = "okay";
};

&usbdrd31_dwc3 {
	/*
	 * Host mode: drive the USB-ethernet dongle through the powered hub the
	 * same way the AOSP image does (phone = USB host, hub sources VBUS to the
	 * dongle). This is the agreed networking path — it keeps the UART tap on
	 * the USB-C breakout usable (no gadget-to-host re-cabling) and reuses the
	 * existing bench topology (phone -> powered hub -> dongle -> LAN). The
	 * peripheral/CDC-NCM gadget path is parked behind Phase B (MAX77759 TCPC).
	 */
	/*
	 * Phase B: TCPM-managed dual-role. The MAX77759 TCPC (tcpc@25 below,
	 * bound by tcpci_maxim) + the generic TCPM state machine drive the
	 * role via usb-role-switch: default peripheral, switch to host when a
	 * sink (the USB-ethernet dongle) attaches on CC. Replaces the earlier
	 * hard dr_mode="host" once the TCPC/connector graph is wired.
	 */
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "host";
	maximum-speed = "high-speed";
	snps,quirk-frame-length-adjustment = <0x20>;
	snps,parkmode-disable-ss-quirk;
	/*
	 * Phase G.11 (felix gs201): match AOSP dwc3_exynos_core_init's
	 * DWC31 180A-190A GFLADJ programming.
	 *
	 * AOSP `dwc3-exynos.c:365` for our exact silicon revision sets
	 * REFCLK_LPM_SEL unconditionally; mainline `dwc3_ref_clk_period`
	 * only sets it when `snps,gfladj-refclk-lpm-sel-quirk` is present.
	 *
	 * `snps,ref-clock-period-ns = <52>` is a hint for the kernel to
	 * use 52 ns (= 1/19.2 MHz) when computing GUCTL.REFCLKPER and the
	 * 240MHz_DECR+PLS1 fields. Mainline ignores the override if it
	 * already has `dwc->ref_clk` (we have one named "ref" via the
	 * inner dwc3 DT clocks property), but pairing it here lets us
	 * verify via the Phase G.11 DBG print: if the kernel-reported
	 * rate is 19200000 we're already correct; if not, the override
	 * surfaces a mismatch we'd otherwise silently program past.
	 */
	snps,gfladj-refclk-lpm-sel-quirk;
	snps,ref-clock-period-ns = <52>;
	/*
	 * Phase G.11 finding (2026-05-08): gs101 clk driver reports
	 * `clk_get_rate(dwc->ref_clk)` = 614400000 (614.4 MHz, which is
	 * 32 × 19.2 MHz — likely the upstream PLL rate, not the
	 * divided-down dwc3 reference). Mainline `dwc3_ref_clk_period`
	 * prefers `dwc->ref_clk` over `dwc->ref_clk_per`, so it
	 * computes period=1ns instead of 52ns and programs GUCTL.REFCLKPER
	 * + GFLADJ with completely wrong values. HS bus timing relies on
	 * these being correct — chirp/handshake at link-state still
	 * works (independent of refclk timing) but byte-level NRZI
	 * decode does not, exactly matching our SETUP-no-show symptom.
	 *
	 * Drop the clocks / clock-names "ref" entries so dwc->ref_clk
	 * stays NULL and the snps,ref-clock-period-ns override path
	 * runs. clk_ignore_unused in our kernel cmdline keeps the
	 * bootloader-enabled HSI0 ref clock running so the dwc3
	 * controller and PHY still get their reference signal — we
	 * just don't have the dwc3 driver call clk_prepare_enable on
	 * it (which is a no-op when dwc->ref_clk is NULL anyway).
	 */
	/delete-property/ clocks;
	/delete-property/ clock-names;
	/*
	 * dma-coherent: keep IO-coherent annotation in case the gs201
	 * interconnect requires it for dwc3 master writes to be visible
	 * to CPU without explicit cache flushes. Empirically harmless
	 * with mainline's HW cache-coherency assumption.
	 *
	 * memory-region = <&xhci_dma>: the gs201 dwc3 DMA master only has
	 * S2MPU permission for this 4 MiB carveout. In HOST mode the actual
	 * DMA is done by the synthetic xhci-hcd child device (dwc3_host_init),
	 * which has no OF node — so the 2026-05-07 attempt to put memory-region
	 * here "didn't propagate": of_dma_configure ran for THIS node, but the
	 * xhci child never inherited it. Fixed driver-side in dwc3/host.c, which
	 * now calls of_reserved_mem_device_init_by_idx(&xhci->dev, dwc-node, 0)
	 * to bind THIS carveout to the xhci child. Keep the property here so the
	 * driver has the region to propagate. (dma-ranges on the outer wrapper
	 * constrained the core's own event buffers, which is why connect/reset
	 * events worked but every transfer's descriptor DMA still -71'd.)
	 */
	memory-region = <&xhci_dma>;
	dma-coherent;
	status = "okay";
};

/* watchdog_cl1 stays disabled: the s3c2410-wdt of_match table maps
 * google,gs201-wdt → drv_data_gs101_cl0 only, so cl1 would inherit
 * cluster-0 PMU register offsets. */
&watchdog_cl1 {
	status = "disabled";
};

/*
 * Override the ramoops carveout layout from gs201-android-handoff.dtsi.
 * Original (AOSP) had only console-size + pmsg-size = 2 MiB + 2 MiB,
 * which leaves zero bytes for dmesg zones. With record-size=0 the kernel
 * creates no DMESG zones, and kmsg_dump(KMSG_DUMP_PANIC) on a kernel
 * panic finds no place to write the panic dmesg — pstore stays empty
 * across the reboot even though the carveout's ring buffer DOES survive
 * the 0xcafe S/W-reboot path (verified: DBGC signature + boot console
 * text round-trips through reset).
 *
 * New layout in the same 4 MiB region:
 *   record-size  = 0x80000  (512 KiB per panic dmesg, 4 records by
 *                            default → 2 MiB for panics)
 *   console-size = 0x100000 (1 MiB ring buffer for live console)
 *   pmsg-size    = 0x100000 (1 MiB for /dev/pmsg0 user beacons)
 */
&{/reserved-memory/ramoops_mem@fd3ff000} {
	record-size = <0x80000>;
	console-size = <0x100000>;
	pmsg-size = <0x100000>;
};


/*
 * Phase B: MAX77759 USB-C TCPC + Type-C Port Manager (TCPM) for automatic host
 * mode. Binds the mainline tcpci_maxim driver via the maxim,max33359 fallback
 * (MAX77759's TCPC is the same TCPCI family). Adapted from mainline
 * gs101-pixel-common.dtsi (Pixel 6, same MAX77759 + same combo PHY). The TCPC
 * alert line is gpa9-7 (felix), now referenceable after the gs201 pinctrl bank
 * nodes were added. NOTE: no vbus-supply yet — this stage validates CC attach
 * detection + role/orientation switching; VBUS sourcing (charger OTG regulator)
 * is wired in a follow-up.
 */
&usbdrd31_phy {
	orientation-switch;

	port {
		usbdrd31_phy_orien_switch: endpoint {
			remote-endpoint = <&usbc0_orien_sw>;
		};
	};
};

&usbdrd31_dwc3 {
	port {
		usbdrd31_dwc3_role_switch: endpoint {
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&hsi2c14 {
	usb-typec@25 {
		compatible = "maxim,max77759-tcpci", "maxim,max33359";
		reg = <0x25>;
		interrupt-parent = <&gpa9>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
		/* OTG/host-mode VBUS via the MAX77759 charger reverse-boost. */
		vbus-supply = <&chgin_otg>;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			/*
			 * data-role="dual" like AOSP: forcing "host" makes the PD
			 * data-role bit collide with the adapter when we attach as a
			 * sink ("Data role mismatch -> error recovery"), which kills
			 * the charge negotiation. Dual lets PD complete; the data
			 * role is then swapped to host separately to keep the dongle.
			 */
			data-role = "dual";
			power-role = "dual";
			self-powered;
			/*
			 * try-source (not AOSP's try-sink): felix must stay the USB
			 * host for the ethernet dongle, so attach as source (DFP),
			 * then let the self-powered dock PR_SWAP us to power-sink
			 * while the data role stays DFP -> charge + keep the dongle.
			 */
			try-power-role = "sink";
			op-sink-microwatt = <2600000>;
			/* Match AOSP felix: FRS + slow-charger-loop so a
			 * self-powered dock can hand power back to us. */
			new-source-frs-typec-current = <FRS_5V_1P5A>;
			slow-charger-loop;
			source-pdos = <PDO_FIXED(5000, 900,
						 (PDO_FIXED_SUSPEND
						  | PDO_FIXED_USB_COMM
						  | PDO_FIXED_DATA_SWAP
						  | PDO_FIXED_DUAL_ROLE))>;
			/* Advertise 9V + PPS sink capability like AOSP so the
			 * dock knows we can take real charging power. */
			sink-pdos = <PDO_FIXED(5000, 3000,
					       (PDO_FIXED_DATA_SWAP
						| PDO_FIXED_USB_COMM
						| PDO_FIXED_HIGHER_CAP
						| PDO_FIXED_DUAL_ROLE))
				     PDO_FIXED(9000, 2200, 0)
				     PDO_PPS_APDO(5000, 11000, 3000)>;
			/*
			 * PD enabled: the port is dual-role (try-power-role=sink),
			 * so it still sources VBUS to a bare dongle, but a PD dock
			 * with external power can PR_SWAP us to sink and charge the
			 * phone while we keep the data-host role for ethernet.
			 */
			typec-power-opmode = "default";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdrd31_phy_orien_switch>;
					};
				};

				port@1 {
					reg = <1>;
					usbc0_role_sw: endpoint {
						remote-endpoint = <&usbdrd31_dwc3_role_switch>;
					};
				};
			};
		};
	};
};

/*
 * MAX77759 PMIC/charger MFD (i2c 0x66). Needed for OTG/host-mode VBUS: the
 * charger's chgin-otg reverse-boost regulator is what the TCPC's vbus-supply
 * points at. The MFD spawns the charger (matched to the child node below via
 * the of_compatible added to its mfd_cell); the charger registers the
 * "chgin-otg" regulator against that node. PMIC IRQ is gpa9-4 (felix, per AOSP
 * if_pmic_int), distinct from the TCPC's gpa9-7.
 */
&hsi2c14 {
	max77759_pmic: pmic@66 {
		compatible = "maxim,max77759";
		reg = <0x66>;
		interrupt-parent = <&gpa9>;
		interrupts = <4 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;

		/*
		 * The max77759 charger driver does
		 * device_set_of_node_from_dev(dev, dev->parent), so its regulator
		 * of_match ("chgin-otg-regulator") is searched among THIS pmic
		 * node's direct children — the regulator must live here, not under
		 * a charger subnode.
		 */
		chgin_otg: chgin-otg-regulator {
			regulator-name = "chgin-otg";
		};
	};
};

/*
 * MAX1720x-family ModelGauge m5 fuel gauge for the base battery (i2c 0x36 on
 * the same hsi2c14 bus). Provides SoC%, VCell, current and temperature. The
 * base gauge has no 0x0b nvmem companion, so the driver falls back to a default
 * rsense. felix's secondary-battery gauge lives on a different i2c bus and is
 * not wired here yet.
 */
&hsi2c14 {
	fuelgauge@36 {
		compatible = "maxim,max17201";
		reg = <0x36>;
		label = "maxfg_base";
		/*
		 * The base pack's gauge has no 0x0b nvram companion, so its
		 * thermistor cal is volatile and reverts to garbage on power
		 * loss (Temp freezes / mis-reads). Golden felix values, from
		 * the AOSP battery-data model; the driver reprograms them and
		 * clears Config.Tex at probe.
		 */
		maxim,thermistor-tgain = /bits/ 16 <0xED51>;
		maxim,thermistor-toff = /bits/ 16 <0x1EBA>;
		maxim,thermistor-tcurve = /bits/ 16 <0x0014>;
	};
};

/*
 * Secondary battery fuel gauge (felix is a dual-battery fold). Same
 * MAX1720x-family gauge on the USI15 bus (i2c 0x36 @ 10da0000); unlike the
 * base pack this one has a real 0x0b nvram companion, so the driver's nvmem
 * probe succeeds and rsense comes from the part. Distinct `label` so the two
 * gauges don't collide on the "max1720x" power-supply name.
 */
&hsi2c15 {
	fuelgauge@36 {
		compatible = "maxim,max17201";
		reg = <0x36>;
		label = "maxfg_secondary";
	};
};

/*
 * Turn off the inner (main fold) OLED at boot.
 *
 * felix's inner panel (samsung ana6707-f10, wired to the DSIM0 path that
 * mainline does not bring up) is lit by the bootloader and never turned off:
 * with no inner display driver it sits at full-brightness white showing the
 * boot logo, drawing multiple watts and adding ~5-6 C to skin temperature
 * (measured: idle skin zones dropped 53-55 C -> 48-49 C once blanked). Its
 * power rails are s2mpg13 sub-PMIC LDOs we have no driver for, so we cannot
 * cut them; instead hold its reset line (gpa7-1) asserted, which blanks the
 * OLED (emission off) at negligible standby cost. Empirically confirmed on
 * felix: driving gpa7-1 low turns the inner panel dark. The outer/cover panel
 * (ea8182-f10, reset on gpp23) is on separate rails/GPIO and is unaffected.
 */
&gpa7 {
	inner-panel-off-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "inner-panel-reset";
	};
};

/*
 * s2mpg13 sub-PMIC bring-up (Phase 1). Only the two inner-display rails are
 * exposed for now: LDO4S (vddi) and LDO28S (vci). IRQ line + ACPM PMIC channel
 * mirror gs101 / AOSP gs201 (sub = gpa0-7, chan 2).
 *
 * sec-acpm is built in (=y) so this probes at boot. Phase 1b confirmed the
 * ACPM *write* path works: with regulator-boot-on removed, the regulator
 * core's unused-regulator cleanup disabled ldo4s/ldo28s over ACPM. But those
 * rails feed the inner ana6707 panel's vddi/vci, and disabling them perturbs
 * the DRM/dsim probe ordering into a long deferred-probe stall (~100 s boot).
 * The inner panel is already dark (and cool) via the gpa7-1 reset hog above,
 * so cutting the rails buys no thermal win. Keep regulator-boot-on: the rails
 * stay up, boot stays fast, and the driver + regulators remain available for
 * the follow-up spmic-thermal (skin) / ODPM phases. ldo4s = vddi, ldo28s =
 * vci of the inner panel (AOSP gs201-felix-display.dtsi); nothing else uses
 * them.
 */
&acpm_ipc {
	s2mpg13: pmic-2 {
		compatible = "samsung,s2mpg13-pmic";
		interrupts-extended = <&gpa0 7 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;

		/* Off-die NTC thermistors sampled by the METER block. */
		s2mpg13_tm: spmic-thermal {
			compatible = "google,s2mpg13-spmic-thermal";
			#thermal-sensor-cells = <1>;
		};

		/*
		 * ODPM per-rail power meter (debugfs), sub-PMIC rails only.
		 * Firmware leaves the 12 METER channels unassigned, so pick the
		 * rails to monitor here. Codes are MUXSEL selectors; this set
		 * mirrors the AOSP felix s2mpg13 ODPM assignment:
		 *   vsen_c4, vsen_c5, ldo9s, buck1s, buck2s, buck4s, buck5s,
		 *   buck8s, buck9s, ldo7s, ldo14s, ldo2s.
		 */
		s2mpg13_odpm: powermeter {
			compatible = "google,s2mpg13-powermeter";
			google,channel-muxsel = /bits/ 8 <
				0x5c 0x5d 0x29 0x01 0x02 0x04
				0x05 0x08 0x09 0x27 0x2e 0x22>;
		};

		regulators {
			ldo4s: ldo4s {
				regulator-name = "s2mpg13_ldo4s_inner_vddi";
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <2275000>;
				regulator-boot-on;
			};

			ldo28s: ldo28s {
				regulator-name = "s2mpg13_ldo28s_inner_vci";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-boot-on;
			};
		};
	};
};

/*
 * s2mpg13 sub-PMIC NTC thermistor zones (board-surface temperatures). Channel
 * map matches AOSP gs201-felix-thermal.dtsi: 0 neutral, 1 quiet, 2 skin,
 * 3/4 usb_pwr, 5 inner_disp, 6 outer_disp, 7 gnss_tcxo. skin_therm is the
 * board-surface backstop we care about most.
 *
 * Bring-up policy: no active polling (polling-delay = 0; read on demand) and a
 * single high passive trip only - no critical/shutdown trips yet, so a bad NTC
 * read during bring-up cannot power the device off. The real skin backstop
 * (55.5/56.5/58.5 C) is a follow-up once the readings are trusted.
 */
&thermal_zones {
	neutral_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 0>;
		trips {
			neutral_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	quiet_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 1>;
		trips {
			quiet_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	skin_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 2>;
		trips {
			skin_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	usb_pwr_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 3>;
		trips {
			usb_pwr_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	usb_pwr_therm2 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 4>;
		trips {
			usb_pwr2_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	inner_disp_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 5>;
		trips {
			inner_disp_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	outer_disp_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 6>;
		trips {
			outer_disp_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	gnss_tcxo_therm {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&s2mpg13_tm 7>;
		trips {
			gnss_tcxo_alert: alert {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};
